{
    "name":  "moe/laravel-shipping",
    "description":  "Shipping module â€” Courier, Zone, Rate",
    "type":  "library",
    "license":  "MIT",
    "keywords":  [
                     "laravel",
                     "shipping",
                     "courier",
                     "zone",
                     "rate",
                     "logistics",
                     "moe"
                 ],
    "authors":  [
                    {
                        "name":  "MindOfEmanizer",
                        "email":  "mindofemanizer@users.noreply.github.com"
                    }
                ],
    "support":  {
                    "issues":  "https://github.com/mindofemanizer/MOE-Laravel-Shipping/issues",
                    "source":  "https://github.com/mindofemanizer/MOE-Laravel-Shipping"
                },
    "require":  {
                    "php":  "^8.2",
                    "illuminate/support":  "^11.0|^12.0|^13.0",
                    "moe/laravel-core":  "dev-main"
                },
    "require-dev":  {
                        "orchestra/testbench":  "^9.0",
                        "pestphp/pest":  "^3.0"
                    },
    "autoload":  {
                     "psr-4":  {
                                   "Moe\\Shipping\\":  "src/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Moe\\Shipping\\Tests\\":  "tests/"
                                   }
                     },
    "repositories":  [
                         {
                             "type":  "vcs",
                             "url":  "https://github.com/mindofemanizer/MOE-Laravel-Core"
                         }
                     ],
    "extra":  {
                  "laravel":  {
                                  "providers":  [
                                                    "Moe\\Shipping\\ShippingServiceProvider"
                                                ]
                              }
              },
    "scripts":  {
                    "test":  "pest",
                    "test-coverage":  "pest --coverage"
                },
    "config":  {
                   "sort-packages":  true,
                   "allow-plugins":  {
                                         "pestphp/pest-plugin":  true
                                     }
               },
    "minimum-stability":  "dev",
    "prefer-stable":  true
}
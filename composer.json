{
    "name": "moe/laravel-shipping",
    "description": "Shipping module — Courier, Zone, Rate",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "shipping",
        "courier",
        "zone",
        "rate",
        "logistics",
        "moe"
    ],
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "mindofemanizer@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mindofemanizer/MOE-Laravel-Shipping/issues",
        "source": "https://github.com/mindofemanizer/MOE-Laravel-Shipping"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "moe/laravel-core": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Moe\\Shipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\Shipping\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mindofemanizer/MOE-Laravel-Core"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\Shipping\\ShippingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
